# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
app*
!app

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# generated prisma clients (build artifacts — run `npm run prisma-generate`)
# No trailing slash: worktrees symlink this path (see /start-fq-task), and a
# trailing-slash pattern only matches a directory, not a symlink of that name.
/app/generated

# local env files
.env*
# docker compose runtime env (may hold credentials); templates *.example stay tracked
.env

# mcp config (contains secrets)
.mcp.json
.codex/config.toml
/opencode.json
.cursor/mcp.json
.playwright-mcp

# vercel
.vercel

# typescript
*.tsbuildinfo

# serwist service worker build output (generated from app/sw.ts)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map

# local docs/plans

# retrospect skill output — never committed
/docs/retrospectives/

# Playwright transient output
/playwright-report/
/test-results/

# claude local settings
settings.local.json

# mujaz-mode local stats (machine-local, not shared)
.claude/.mujaz-stats.json
.claude/.mujaz-off

# graphify machine-local/regenerable state (keep GRAPH_REPORT.md, graph.html, graph.json)
/graphify-out/.*
/graphify-out/*.lock
/graphify-out/cache/
/graphify-out/cost.json
/graphify-out/manifest.json
/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# impeccable machine-local settings + per-run scratch output (keep DESIGN.md, .impeccable/design.json)
.impeccable/config.local.json
/.impeccable/critique/
