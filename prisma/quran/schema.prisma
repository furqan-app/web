generator client {
  provider = "prisma-client-js"
  output   = "../../app/generated/quran-client"
}

datasource db {
  provider = "mysql"
  url      = env("QURAN_DATABASE_URL")
}

model Chapter {
  id                 Int                  @id @default(autoincrement())
  chapter_number     Int
  bismillah_pre      Boolean              @default(false)
  revelation_order   Int
  revelation_place   String
  name_complex       String
  name_arabic        String
  name_simple        String
  verses_count       Int
  pages              String
  translated_name    String
  verses             Verse[]
  pageMetadata       PageMetadata[]
  mushafPageMetadata MushafPageMetadata[]

  @@map("chapters")
}

model Verse {
  id                 Int     @id @default(autoincrement())
  verse_number       Int
  verse_key          String
  hizb_number        Int
  rub_el_hizb_number Int
  ruku_number        Int
  manzil_number      Int
  sajdah_number      Int?
  text_uthmani       String  @db.Text
  chapter_id         Int
  text_imlaei_simple String  @db.Text
  page_number        Int
  juz_number         Int
  chapter            Chapter @relation(fields: [chapter_id], references: [id])
  Word               Word[]
  startRub           Rub[]   @relation("StartVerse")
  endRub             Rub[]   @relation("EndVerse")

  @@map("verses")
}

model Word {
  id               Int                @id @default(autoincrement())
  position         Int
  audio_url        String?
  verse_key        String
  verse_id         Int
  location         String
  text_uthmani     String
  code_v1          String
  code_v2          String
  qpc_uthmani_hafs String
  char_type_name   String
  page_number      Int
  line_number      Int
  text             String
  verse            Verse              @relation(fields: [verse_id], references: [id])
  mushafLayouts    MushafWordLayout[]
  // WordTranslation     WordTranslation[]
  // WordTransliteration WordTransliteration[]

  @@map("words")
}

// A mushaf edition's COMPLETE word placement — both page and line. A mushaf is a
// typeset book: a committee fixes where every word sits for that specific print
// edition, so editions disagree on page boundaries, not only on line breaks (56
// verses and 361 words differ between mushaf 2 and mushaf 19). There is no base
// edition and no override layer — mushaf 2 and 19 are equal sets of rows here,
// and a further edition is a further set of rows, never a schema change.
//
// Word.page_number / Word.line_number above survive ONLY as a denormalized
// mirror of the default edition, for mark canonicalization and legacy queries.
// They are not the canonical placement of anything — read this table instead.
// See ADR 0033.
model MushafWordLayout {
  id          Int  @id @default(autoincrement())
  mushaf_id   Int
  word_id     Int
  page_number Int
  line_number Int
  word        Word @relation(fields: [word_id], references: [id])

  @@unique([mushaf_id, word_id])
  @@index([mushaf_id, page_number])
  @@map("mushaf_word_layouts")
}

// Per-edition page summary. Derived from which verses land on which page, so it
// diverges wherever pagination does: mushaf 2 and 19 differ on 8 pages —
// page_surahs on 586/590/593/595/597/598, and hizb_position sits on page 599
// for mushaf 2 but page 600 for mushaf 19. See ADR 0033.
model MushafPageMetadata {
  id            Int     @id @default(autoincrement())
  mushaf_id     Int
  page_number   Int
  surah_id      Int
  page_surahs   String
  juz_number    Int
  hizb_number   Int
  hizb_position String?
  chapter       Chapter @relation(fields: [surah_id], references: [id])

  @@unique([mushaf_id, page_number])
  @@map("mushaf_page_metadata")
}

// Superseded by MushafPageMetadata (ADR 0033). Retained only until its remaining
// consumers move to the per-edition table; holds the default edition's values.
// Do not add new readers.
model PageMetadata {
  id            Int     @id @default(autoincrement())
  page_number   Int     @unique
  surah_id      Int
  page_surahs   String
  juz_number    Int
  hizb_number   Int
  hizb_position String?
  chapter       Chapter @relation(fields: [surah_id], references: [id])

  @@map("page_metadata")
}

